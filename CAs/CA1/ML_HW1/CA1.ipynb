   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "\n",
    "def standardize_data(X):\n",
    "    mean = np.mean(X, axis=0)\n",
    "    std = np.std(X, axis=0)\n",
    "    return (X - mean) / std\n",
    "\n",
    "\n",
    "def normalize_data(X):\n",
    "    min_val = np.min(X, axis=0)\n",
    "    max_val = np.max(X, axis=0)\n",
    "    return (X - min_val) / (max_val - min_val)\n",
    "\n",
    "\n",
    "def compute_mse(y_true, y_pred):\n",
    "    return np.mean((y_true - y_pred) ** 2)\n",
    "\n",
    "\n",
    "def normal_equation_solution(X, y):\n",
    "    return np.linalg.inv(X.T.dot(X)).dot(X.T).dot(y)\n",
    "\n",
    "\n",
    "def gradient_descent_solution(X, y, learning_rate=0.001, num_iterations=10000):\n",
    "    theta = np.zeros(X.shape[1])\n",
    "    m = len(y)\n",
    "    loss_history = []\n",
    "\n",
    "    for i in range(num_iterations):\n",
    "        y_pred = X.dot(theta)\n",
    "        gradient = (1 / m) * X.T.dot(y_pred - y)\n",
    "        theta -= learning_rate * gradient\n",
    "        loss = np.mean((y - y_pred) ** 2)\n",
    "        loss_history.append(loss)\n",
    "\n",
    "    return theta, loss_history\n",
    "\n",
    "\n",
    "X = data[\"experience\"].values.reshape(-1, 1)\n",
    "y = data[\"income\"].values\n",
    "\n",
    "\n",
    "X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.20, random_state=101)\n",
    "\n",
    "\n",
    "datasets = {\n",
    "    \"Original\": X_train,\n",
    "    \"Standardized\": standardize_data(X_train),\n",
    "    \"Normalized\": normalize_data(X_train)\n",
    "}\n",
    "\n",
    "results = {}\n",
    "\n",
    "\n",
    "for label, X_train_current in datasets.items():\n",
    "    \n",
    "    if label == \"Standardized\":\n",
    "        X_test_current = standardize_data(X_test)\n",
    "    elif label == \"Normalized\":\n",
    "        X_test_current = normalize_data(X_test)\n",
    "    else:\n",
    "        X_test_current = X_test\n",
    "\n",
    "    \n",
    "    X_train_ones = np.c_[np.ones(X_train_current.shape[0]), X_train_current]\n",
    "    X_test_ones = np.c_[np.ones(X_test_current.shape[0]), X_test_current]\n",
    "\n",
    "    \n",
    "    theta_normal = normal_equation_solution(X_train_ones, y_train)\n",
    "    y_pred_normal = X_test_ones.dot(theta_normal)\n",
    "    mse_normal = compute_mse(y_test, y_pred_normal)\n",
    "\n",
    "    \n",
    "    theta_gd, loss_history = gradient_descent_solution(X_train_ones, y_train)\n",
    "    y_pred_gd = X_test_ones.dot(theta_gd)\n",
    "    mse_gd = compute_mse(y_test, y_pred_gd)\n",
    "\n",
    "    \n",
    "    results[label] = {\n",
    "        \"MSE_Normal\": mse_normal,\n",
    "        \"MSE_GD\": mse_gd,\n",
    "        \"theta_normal\": theta_normal,\n",
    "        \"theta_gd\": theta_gd,\n",
    "        \"loss_history\": loss_history,\n",
    "        \"X_test\": X_test_current,\n",
    "        \"y_pred_normal\": y_pred_normal,\n",
    "        \"y_pred_gd\": y_pred_gd\n",
    "    }\n",
    "\n",
    "    \n",
    "    plt.figure(figsize=(12, 5))\n",
    "\n",
    "    plt.subplot(1, 2, 1)\n",
    "    plt.scatter(X_test_current, y_test, label='Actual Data')\n",
    "    plt.plot(X_test_current, y_pred_normal, color='red', label='Normal Equation Line')\n",
    "    plt.xlabel('Experience')\n",
    "    plt.ylabel('Income')\n",
    "    plt.title(f'{label} - Normal Equation Solution')\n",
    "    plt.legend()\n",
    "\n",
    "    plt.subplot(1, 2, 2)\n",
    "    plt.scatter(X_test_current, y_test, label='Actual Data')\n",
    "    plt.plot(X_test_current, y_pred_gd, color='blue', label='Gradient Descent Line')\n",
    "    plt.xlabel('Experience')\n",
    "    plt.ylabel('Income')\n",
    "    plt.title(f'{label} - Gradient Descent Solution')\n",
    "    plt.legend()\n",
    "\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "    \n",
    "    plt.figure(figsize=(8, 6))\n",
    "    plt.plot(range(len(loss_history)), loss_history, color='purple', label='Gradient Descent Loss')\n",
    "    plt.axhline(y=mse_normal, color='red', linestyle='--', label='Normal Equation MSE')\n",
    "    plt.xlabel('Iterations')\n",
    "    plt.ylabel('Mean Squared Error (Loss)')\n",
    "    plt.title(f'{label} - Loss Over Iterations with Normal Equation Comparison')\n",
    "    plt.legend()\n",
    "    plt.show()\n",
    "\n",
    "\n",
    "print(\"MSE Comparison for Original, Standardized, and Normalized Data:\")\n",
    "for label, res in results.items():\n",
    "    print(f\"{label} Data - MSE (Normal Equation): {res['MSE_Normal']:.4f}, MSE (Gradient Descent): {res['MSE_GD']:.4f}\")\n"
   ]
