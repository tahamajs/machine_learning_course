    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "for column in dataset_diabets.columns[:-1]: \n",
    "    dataset_diabets[column] = pd.to_numeric(dataset_diabets[column], errors='coerce')\n",
    "\n",
    "dataset_diabets.dropna(inplace=True)\n",
    "\n",
    "\n",
    "def normalize_data(df):\n",
    "    min_val = df.min()\n",
    "    max_val = df.max()\n",
    "    return (df - min_val) / (max_val - min_val)\n",
    "\n",
    "\n",
    "def standardize_data(df):\n",
    "    mean_val = df.mean()\n",
    "    std_val = df.std()\n",
    "    return (df - mean_val) / std_val\n",
    "\n",
    "\n",
    "normalized_df = dataset_diabets.iloc[:, :-1].apply(normalize_data)\n",
    "standardized_df = dataset_diabets.iloc[:, :-1].apply(standardize_data)\n",
    "\n",
    "\n",
    "normalized_df['Outcome'] = dataset_diabets['Outcome'].values\n",
    "standardized_df['Outcome'] = dataset_diabets['Outcome'].values\n",
    "\n",
    "\n",
    "feature_pairs = [(normalized_df.columns[i], normalized_df.columns[j]) \n",
    "                 for i in range(len(normalized_df.columns) - 1) \n",
    "                 for j in range(i + 1, len(normalized_df.columns) - 1)]\n",
    "\n",
    "\n",
    "def plot_feature_pairs(df, feature_pairs, data_label):\n",
    "    for feature_1, feature_2 in feature_pairs:\n",
    "        sns.jointplot(x=feature_1, y=feature_2, data=df, kind='kde', hue='Outcome', fill=True)\n",
    "        plt.suptitle(f'{data_label} Joint Plot of {feature_1} and {feature_2}', y=1.05)\n",
    "        plt.show()\n",
    "\n",
    "\n",
    "print(\"Normalized Data Feature Pair Plots\")\n",
    "plot_feature_pairs(normalized_df, feature_pairs, data_label=\"Normalized\")\n",
    "\n",
    "\n",
    "print(\"Standardized Data Feature Pair Plots\")\n",
    "plot_feature_pairs(standardized_df, feature_pairs, data_label=\"Standardized\")\n",
    "\n",
    "\n",
    "print(\"Normalized Data Statistics:\\n\", normalized_df.describe())\n",
    "print(\"\\nStandardized Data Statistics:\\n\", standardized_df.describe())\n"
   ]
  },
