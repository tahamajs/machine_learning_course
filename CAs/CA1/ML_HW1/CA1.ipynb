   "source": [
    "import pandas as pd\n",
    "import seaborn as sns\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "print(\"Original Data Visualizations\")\n",
    "\n",
    "data.hist(bins=10, figsize=(10, 8))\n",
    "plt.suptitle('Original Data Histograms')\n",
    "plt.show()\n",
    "\n",
    "sns.pairplot(data)\n",
    "plt.suptitle('Original Data Pairplot', y=1.02)\n",
    "plt.show()\n",
    "\n",
    "plt.figure(figsize=(8, 6))\n",
    "sns.heatmap(data.corr(), annot=True, cmap='coolwarm', square=True)\n",
    "plt.title('Original Data Correlation Heatmap')\n",
    "plt.show()\n",
    "\n",
    "\n",
    "def normalize_data(df):\n",
    "    return (df - df.min()) / (df.max() - df.min())\n",
    "\n",
    "\n",
    "def standardize_data(df):\n",
    "    return (df - df.mean()) / df.std()\n",
    "\n",
    "print(\"Normalized Data Visualizations\")\n",
    "\n",
    "data_normalized = normalize_data(data)\n",
    "\n",
    "data_normalized.hist(bins=10, figsize=(10, 8))\n",
    "plt.suptitle('Normalized Data Histograms')\n",
    "plt.show()\n",
    "\n",
    "sns.pairplot(data_normalized)\n",
    "plt.suptitle('Normalized Data Pairplot', y=1.02)\n",
    "plt.show()\n",
    "\n",
    "plt.figure(figsize=(8, 6))\n",
    "sns.heatmap(data_normalized.corr(), annot=True, cmap='coolwarm', square=True)\n",
    "plt.title('Normalized Data Correlation Heatmap')\n",
    "plt.show()\n",
    "\n",
    "print(\"Standardized Data Visualizations\")\n",
    "\n",
    "data_standardized = standardize_data(data)\n",
    "\n",
    "data_standardized.hist(bins=10, figsize=(10, 8))\n",
    "plt.suptitle('Standardized Data Histograms')\n",
    "plt.show()\n",
    "\n",
    "sns.pairplot(data_standardized)\n",
    "plt.suptitle('Standardized Data Pairplot', y=1.02)\n",
    "plt.show()\n",
    "\n",
    "plt.figure(figsize=(8, 6))\n",
    "sns.heatmap(data_standardized.corr(), annot=True, cmap='coolwarm', square=True)\n",
    "plt.title('Standardized Data Correlation Heatmap')\n",
    "plt.show()\n"
   ]
  },
